<UserControl x:Class="TradingCompany.WPF.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="350" Width="400">
    <Border Background="White" CornerRadius="10" Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
        </Border.Effect>
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Trading System" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Login"/>
            <TextBox Text= "{Binding LoginData.Login, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Margin="0,5,0,10" Padding="5"/>

            <TextBlock Text="Password"/>
            <PasswordBox x:Name="txtPass" Margin="0,5,0,20" Padding="5"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <Button Content="Sign In" 
                    Command="{Binding LoginCommand}" 
                    CommandParameter="{Binding ElementName=txtPass}"
                    Height="35" Background="#007ACC" Foreground="White"/>
        </StackPanel>
    </Border>
</UserControl>