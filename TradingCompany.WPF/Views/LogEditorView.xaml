<Window x:Class="TradingCompany.WPF.Views.LogEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log Editor" Height="300" Width="350" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Border Padding="20" Background="White">
        <StackPanel>
            <TextBlock Text="Edit Log" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <TextBlock Text="Action Description"/>
            <TextBox Text="{Binding Log.Action, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Margin="0,5,0,10" Padding="5"/>

            <TextBlock Text="User"/>
            <ComboBox ItemsSource="{Binding Users}" 
          DisplayMemberPath="Login" 
          SelectedValuePath="UserId" 
          SelectedValue="{Binding Log.UserId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
          Height="30"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" Command="{Binding SaveCommand}" Background="#28A745" Foreground="White" Width="70" Height="25" Margin="0,0,10,0"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" Background="#6C757D" Foreground="White" Width="70" Height="25"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>